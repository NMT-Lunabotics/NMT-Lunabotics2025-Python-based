def collector(out_q: queue.Queue, stop_evt: threading.Event):
    """Collects scans, runs SLAM, pushes (map_img, x_mm, y_mm, theta_deg) to out_q."""
    laser = Laser(BINS, TARGET_SCAN_HZ, FOV_DEG, MAX_DIST_MM)
    slam  = RMHC_SLAM(laser, MAP_SIZE_PIXELS, MAP_SIZE_METERS)
    mapbuf = bytearray(MAP_SIZE_PIXELS * MAP_SIZE_PIXELS)

    lidar = None
    distances = np.zeros(BINS, dtype=np.int32)
    have_bins = np.zeros(BINS, dtype=bool)
    t0 = time.time()
    last_status = 0

    while not stop_evt.is_set():
        try:
            lidar = open_lidar()
            try:
                info = lidar.get_info(); health = lidar.get_health()
                print("Connected:", info, "Health:", health)
            except Exception:
                pass

            meas_iter = lidar.iter_measures(max_buf_meas=MAX_BUF_MEAS)
            distances.fill(0); have_bins.fill(False); t0 = time.time()

            for new_scan, q, angle, distance in meas_iter:
                if stop_evt.is_set():
                    break

                # backlog flush ...
                try:
                    iw = lidar._serial.in_waiting
                    if iw > IN_WAITING_FLUSH:
                        print(f"Too many bytes in buffer: {iw}/{IN_WAITING_FLUSH}. Flushing…")
                        try: lidar._serial.reset_input_buffer()
                        except Exception:
                            try: lidar.clear_input()
                            except Exception: pass
                        time.sleep(0.01)  # small settle
                        continue
                except Exception:
                    pass

                if new_scan:
                    if have_bins.sum() > BINS * 0.3 and (time.time() - t0) > WARMUP_S:
                        scans = distances.tolist()
                        slam.update(scans)
                        x_mm, y_mm, theta_deg = slam.getpos()
                        slam.getmap(mapbuf)

                        mapimg = np.frombuffer(mapbuf, dtype=np.uint8).reshape(MAP_SIZE_PIXELS, MAP_SIZE_PIXELS)
                        vis = 255 - mapimg

                        # Push to viewer
                        if not out_q.empty():
                            try: out_q.get_nowait()
                            except queue.Empty: pass
                        out_q.put((vis.copy(), x_mm, y_mm, theta_deg), block=False)

                        # --- ### NEW ### publish control telemetry ---
                        # compute min distance in forward arc: angles near 0°, i.e., bins [359-20..0..20]
                        arc_bins = list(range(0, FRONT_ARC_DEG+1)) + list(range(BINS-FRONT_ARC_DEG, BINS))
                        vals = [distances[k] for k in arc_bins if have_bins[k] and 0 < distances[k] <= MAX_DIST_MM]
                        front_min = min(vals) if vals else MAX_DIST_MM + 1
                        tele = {"front_min_mm": int(front_min),
                                "x_mm": int(x_mm), "y_mm": int(y_mm), "theta_deg": float(theta_deg)}
                        if not telemetry_q.full():
                            telemetry_q.put_nowait(tele)

                        # status print
                        if STATUS_EVERY > 0 and (time.time() - last_status) >= STATUS_EVERY:
                            dist_from_origin = math.hypot(x_mm, y_mm)
                            print(f"POSE  x={x_mm:.0f} mm  y={y_mm:.0f} mm  θ={theta_deg:.1f}°  |  |r|={dist_from_origin/1000:.2f} m  | front_min={front_min} mm")
                            last_status = time.time()

                    distances.fill(0); have_bins.fill(False)
                    time.sleep(SLEEP_ON_NEW_SCAN)
                    continue

                d = int(distance)
                if d <= 0 or d > MAX_DIST_MM:
                    continue
                k = int(angle) % BINS
                if not have_bins[k] or d < distances[k]:
                    distances[k] = d
                    have_bins[k] = True

        except (OSError, serial.SerialException, RPLidarException) as e:
            print(f"[WARN] LIDAR stream error: {e}. Resetting…")
            time.sleep(0.8)
        except KeyboardInterrupt:
            break
        finally:
            try:
                if lidar:
                    lidar.stop(); lidar.stop_motor(); lidar.disconnect()
                    lidar = None
            except Exception:
                pass


### NEW ###  # Simple autonomous driver thread
def driver(stop_evt: threading.Event):
    ser = open_rover()
    if not ser:
        print("[ERR] No rover UART; driver thread exiting.")
        return

    # safety: stop on start
    send_rover(ser, {"T":0})

    last_cmd = None
    last_send = 0.0

    try:
        while not stop_evt.is_set():
            try:
                tele = telemetry_q.get(timeout=0.5)
            except queue.Empty:
                # keep rover alive but do nothing
                continue

            dmin = tele["front_min_mm"]

            # --- decision policy ---
            if dmin <= STOP_MM:
                cmd = {"T":1, "L": TURN_L, "R": TURN_R}   # turn in place to clear front
            elif dmin <= CAUTION_MM:
                cmd = {"T":1, "L": SLOW_L, "R": SLOW_R}   # slow creep
            else:
                cmd = {"T":1, "L": FWD_L,  "R": FWD_R}    # go

            # avoid spamming same command too fast
            now = time.time()
            if cmd != last_cmd or (now - last_send) > 0.25:
                send_rover(ser, cmd)
                last_cmd = cmd
                last_send = now

    except KeyboardInterrupt:
        pass
    finally:
        try:
            send_rover(ser, {"T":0})  # emergency stop
            ser.close()
        except Exception:
            pass


