### NEW ###  # Rover UART + basic obstacle policy
ROVER_PORT = os.environ.get("ROVER_PORT", "/dev/serial0")
ROVER_BAUD = 1_000_000
FRONT_ARC_DEG = 20                 # +/- span around 0° (robot forward)
STOP_MM = 500                      # stop if obstacle closer than this
CAUTION_MM = 800                   # slow/turn if closer than this
FWD_L = 150; FWD_R = 150           # forward speeds
REV_L = -200; REV_R = -200         # reverse speeds
TURN_L = -180; TURN_R = 180        # in-place turn speeds
SLOW_L = 110; SLOW_R = 110         # cautious forward

### NEW ###  # Queues for cross-thread comms
telemetry_q = queue.Queue(maxsize=3)  # from collector -> driver


### NEW ###  # Rover serial helpers
def open_rover():
    try:
        ser = serial.Serial(ROVER_PORT, ROVER_BAUD, timeout=0.2)
        return ser
    except serial.SerialException as e:
        print(f"[ERR] Rover UART open failed: {e}")
        return None

def send_rover(ser, cmd: dict):
    """cmd like {'T':1,'L':150,'R':150} or {'T':0}"""
    try:
        ser.write((json.dumps(cmd) + "\n").encode())
    except Exception as e:
        print(f"[WARN] rover send failed: {e}")


