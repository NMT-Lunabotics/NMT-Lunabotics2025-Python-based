def main():
    # Inter-thread queues
    q = queue.Queue(maxsize=1)
    stop_evt = threading.Event()

    th_collect = threading.Thread(target=collector, args=(q, stop_evt), daemon=True)
    th_drive   = threading.Thread(target=driver,    args=(stop_evt,),   daemon=True)

