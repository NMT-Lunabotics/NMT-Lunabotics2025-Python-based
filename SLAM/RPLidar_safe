#!/usr/bin/env python3
"""
RPLIDAR S1 -> BreezySLAM live map (matplotlib viewer, conservative serial)
- Auto-detects the serial port (or set RPLIDAR_PORT=/dev/serial/by-id/...)
- Uses iter_measures for smoother serial consumption
- Avoids set_pwm to reduce USB flakiness
- Flushes stale bytes if the serial buffer grows too large
- Displays a live occupancy grid map (updates ~10 Hz)
"""

import os, glob, math, time, threading, queue, sys
import numpy as np
import serial
from rplidar import RPLidar, RPLidarException
from breezyslam.algorithms import RMHC_SLAM
from breezyslam.sensors import Laser

import matplotlib
# Force a backend that works well on Pi without Qt
if "MPLBACKEND" not in os.environ:
    matplotlib.use("TkAgg")
import matplotlib.pyplot as plt

# ---------- TUNABLES ----------
BAUD = 256000
TIMEOUT_S = 5
WARMUP_S = 2.0               # skip first seconds (motor spin-up)
MAX_DIST_MM = 40000
FOV_DEG = 360
BINS = 360                   # 1° bins
TARGET_SCAN_HZ = 10
MAP_SIZE_METERS = 20.0
MAP_SIZE_PIXELS = 800
MAX_BUF_MEAS = 1500          # allow bursts
IN_WAITING_FLUSH = 700       # flush threshold
SLEEP_ON_NEW_SCAN = 0.01     # small breather to reduce backlog
# -----------------------------

def find_port():
    p = os.environ.get('RPLIDAR_PORT')
    if p and os.path.exists(p): return p
    ids = sorted(glob.glob('/dev/serial/by-id/*'))
    if ids: return ids[0]
    for patt in ('/dev/ttyUSB*','/dev/ttyACM*'):
        m = sorted(glob.glob(patt))
        if m: return m[0]
    return None

def open_lidar():
    port = find_port()
    if not port:
        raise serial.SerialException("No RPLIDAR serial device found.")
    lidar = RPLidar(port, baudrate=BAUD, timeout=TIMEOUT_S)
    # purge stale bytes
    try: lidar.clear_input()
    except Exception:
        try: lidar._serial.reset_input_buffer()
        except Exception: pass
    lidar.start_motor()
    time.sleep(0.5)
    return lidar

def collector(map_queue: queue.Queue, stop_evt: threading.Event):
    """Collects scans, runs SLAM, pushes the latest map into map_queue as np.uint8 array."""
    laser = Laser(BINS, TARGET_SCAN_HZ, FOV_DEG, MAX_DIST_MM)
    slam  = RMHC_SLAM(laser, MAP_SIZE_PIXELS, MAP_SIZE_METERS)
    mapbuf = bytearray(MAP_SIZE_PIXELS * MAP_SIZE_PIXELS)

    lidar = None
    t0 = None
    distances = np.zeros(BINS, dtype=np.int32)
    have_bins = np.zeros(BINS, dtype=bool)

    while not stop_evt.is_set():
        try:
            lidar = open_lidar()
            # print basic info (once per connect)
            try:
                print("Connected:", lidar.get_info(), "Health:", lidar.get_health())
            except Exception:
                pass

            meas_iter = lidar.iter_measures(max_buf_meas=MAX_BUF_MEAS)
            t0 = time.time()
            distances.fill(0); have_bins.fill(False)

            for new_scan, q, angle, distance in meas_iter:
                if stop_evt.is_set():
                    break

                # flush if backlog grows
                try:
                    iw = lidar._serial.in_waiting
                    if iw > IN_WAITING_FLUSH:
                        print(f"Too many bytes in buffer: {iw}/{IN_WAITING_FLUSH}. Flushing…")
                        try: lidar._serial.reset_input_buffer()
                        except Exception:
                            try: lidar.clear_input()
                            except Exception: pass
                        continue
                except Exception:
                    pass

                if new_scan:
                    if have_bins.sum() > BINS * 0.3 and (time.time() - t0) > WARMUP_S:
                        slam.update(distances.tolist())  # BreezySLAM expects list
                        slam.getmap(mapbuf)
                        # Convert to image (invert to show occupied=black, free=white)
                        mapimg = np.frombuffer(mapbuf, dtype=np.uint8).reshape(MAP_SIZE_PIXELS, MAP_SIZE_PIXELS)
                        vis = 255 - mapimg
                        # Push the latest map; keep only the newest to avoid queue buildup
                        if not map_queue.empty():
                            try: map_queue.get_nowait()
                            except queue.Empty: pass
                        map_queue.put(vis.copy(), block=False)

                    distances.fill(0); have_bins.fill(False)
                    time.sleep(SLEEP_ON_NEW_SCAN)
                    continue

                d = int(distance)
                if d <= 0 or d > MAX_DIST_MM:  # drop invalid/too-far
                    continue
                k = int(angle) % BINS
                if not have_bins[k] or d < distances[k]:
                    distances[k] = d
                    have_bins[k] = True

        except (OSError, serial.SerialException, RPLidarException) as e:
            print(f"[WARN] LIDAR stream error: {e}. Resetting…")
            time.sleep(0.8)
        except KeyboardInterrupt:
            break
        finally:
            try:
                if lidar:
                    lidar.stop(); lidar.stop_motor(); lidar.disconnect()
                    lidar = None
            except Exception:
                pass

def main():
    # Queue for latest map from collector thread
    map_queue = queue.Queue(maxsize=1)
    stop_evt = threading.Event()
    th = threading.Thread(target=collector, args=(map_queue, stop_evt), daemon=True)
    th.start()

    # Matplotlib live viewer
    plt.ion()
    fig, ax = plt.subplots(figsize=(6,6))
    ax.set_title("RPLIDAR S1 - Live SLAM Map")
    ax.set_xticks([]); ax.set_yticks([])
    # Start with blank image
    img = ax.imshow(np.full((MAP_SIZE_PIXELS, MAP_SIZE_PIXELS), 255, dtype=np.uint8),
                    cmap='gray', vmin=0, vmax=255, interpolation='nearest')
    fig.canvas.draw(); fig.canvas.flush_events()

    try:
        while plt.fignum_exists(fig.number):
            try:
                vis = map_queue.get(timeout=0.2)
                img.set_data(vis)
                fig.canvas.draw()
                fig.canvas.flush_events()
            except queue.Empty:
                pass
            plt.pause(0.01)
    except KeyboardInterrupt:
        pass
    finally:
        stop_evt.set()
        th.join(timeout=2.0)

if __name__ == '__main__':
    # Strongly recommended on Pi: disable autosuspend and use a short/thick USB cable or powered hub.
    #   echo -1 | sudo tee /sys/module/usbcore/parameters/autosuspend
    #   (make persistent by appending 'usbcore.autosuspend=-1' to /boot/firmware/cmdline.txt and reboot)
    main()  
